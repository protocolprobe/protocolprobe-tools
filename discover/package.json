{
  "name": "protocolprobe-discover",
  "version": "0.1.2",
  "description": "Lists the MCP servers configured on this machine and, offline, which are in the official MCP registry. Reads config files only; sends nothing anywhere; never prints secrets.",
  "type": "module",
  "license": "ISC",
  "author": "ProtocolProbe <hello@protocolprobe.com>",
  "homepage": "https://protocolprobe.com/docs/discover",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "inventory",
    "shadow-it"
  ],
  "bin": {
    "protocolprobe-discover": "discover.mjs"
  },
  "main": "discover.mjs",
  "files": [
    "discover.mjs",
    "lib.mjs",
    "registry-index.mjs",
    "registry-index.json.gz",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test discover.test.mjs registry-match.test.mjs package.test.mjs"
  }
}
