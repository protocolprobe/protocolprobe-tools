  "type": "module",
  "license": "ISC",
  "author": "ProtocolProbe <hello@protocolprobe.com>",
  "homepage": "https://protocolprobe.com/docs/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protocolprobe/protocolprobe-tools.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/protocolprobe/protocolprobe-tools/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "registry"
  ],
  "bin": {
    "protocolprobe-mcp": "server.mjs"
  },
  "main": "server.mjs",
  "files": [
    "server.mjs",
    "lib.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
